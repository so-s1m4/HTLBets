generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameType {
  ROULETTE
  BLACKJACK
  POKER
  MINER
  CRASH
  SLOTS
  ADMIN
}

enum GameSessionStatus {
  IDLE
  WAITING_ACTION
  COMPLETED
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  username          String?
  avatarUrl         String?
  selectedCardDeckId String                @default("classic-dark")
  bannedAt          DateTime?
  passwordHash      String?
  lastDailyLoginAt  String?
  balance           BigInt                  @default(1000)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  gameSessions      GameSession[]
  gameHistory       GameHistory[]
  dailyTaskClaims   DailyTaskClaim[]
  ownedCardDecks    UserCardDeck[]

  @@index([email])
}

model CardDeck {
  id           String         @id
  name         String
  price        Int
  backImageUrl String
  faceImageTemplate String    @default("/cards/{suit}_{rank}.png")
  isDefault    Boolean        @default(false)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  owners       UserCardDeck[]

  @@index([enabled, createdAt])
}

model UserCardDeck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    String
  deck      CardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, deckId])
  @@index([userId, createdAt])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, used, expiresAt])
}

model GameSession {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType   GameType
  status     GameSessionStatus @default(IDLE)
  currentBet BigInt            @default(0)
  state      Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, gameType, status])
}

model GameHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType      GameType
  betAmount     BigInt
  result        String
  balanceChange BigInt
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyTaskClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskKey   String
  claimDate String
  createdAt DateTime @default(now())

  @@unique([userId, taskKey, claimDate])
  @@index([userId, claimDate])
}
