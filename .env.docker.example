# DEVELOPMENT ENVIRONMENT VARIABLES
DEV_CLIENT_PORT=4200
DEV_SERVER_PORT=4201
DEV_TRUST_PROXY=1

# DEPLOYMENT ENVIRONMENT VARIABLES
SERVER_PUBLISHED_PORT=127.0.0.1:3009
CLIENT_PUBLISHED_PORT=4209
DEPLOY_TRUST_PROXY=2

# DATABASE
POSTGRES_DB=htl_bets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PUBLISHED_PORT=5432





# generated local server runtime values
# npm run dev keeps these in sync with the entries above
NODE_ENV=development
PORT=4201
CLIENT_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/htl_bets
TRUST_PROXY=1

# client runtime values
CLIENT_API_URL=/api
CLIENT_SOCKET_URL=
DEBUG_AUTH=false

# SHARED APP SETTINGS
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CODE_HASH_SECRET=
AUTH_CODE_TTL_MINUTES=10

MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASS=replace-with-your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_DEBUG_BCC=


ADMIN_EMAILS=admin@example.com
